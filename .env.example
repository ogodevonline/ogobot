# Database
DATABASE_URL=sqlite+aiosqlite:///./seac.db

# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_ADMIN_ID=your_admin_id_here

# Logging
LOG_LEVEL=INFO

# Pydantic AI (OpenAI-compatible provider)
# Поддерживаемые провайдеры: OpenAI, Groq, Anthropic, Ollama, etc.
LLM_PROVIDER=groq
LLM_API_KEY=your_api_key_here
LLM_MODEL=mixtral-8x7b-32768

# Logfire
LOGFIRE_TOKEN=your_logfire_token_here
